# Copy to .env (never commit it). Generate values with:
#   python -m airspace.cli gen-pepper
#   python -m airspace.cli gen-key        (once per key)
#   python -m airspace.cli gen-data-key   (AES-256 data key; in production unwrap it from your KMS at start-up)
AIRSPACE_ENV=production
AIRSPACE_PEPPER=<base64 32 bytes>
AIRSPACE_JWT_KEYS=k2026q4:<base64 PEM>,k2026q3:<base64 PEM previous, during rotation only>
AIRSPACE_EVIDENCE_KEY=<base64 PEM>
AIRSPACE_DATA_KEYS=d2026q4:<base64 32 bytes>,d2026q3:<previous key, only until rewrap-data reports zero>
# Refuse plain http (default on in production). Behind a TLS-terminating gateway, list it in TRUSTED_PROXIES.
AIRSPACE_REQUIRE_HTTPS=1
# Bot protection: challenge after N failed logins per account or IP. pow needs no third party.
AIRSPACE_CHALLENGE_AFTER=3
AIRSPACE_CHALLENGE_PROVIDER=pow
AIRSPACE_POW_DIFFICULTY=18
# Only for turnstile or hcaptcha:
# AIRSPACE_CHALLENGE_SECRET_FILE=/run/secrets/captcha_secret
AIRSPACE_ISSUER=https://airspace.example/auth
AIRSPACE_AUDIENCE=airspace-api
AIRSPACE_CORS_ORIGINS=https://console.airspace.example
# Only behind our own gateway: trust X-Forwarded-For from these peers, counting hops from the right.
AIRSPACE_TRUST_PROXY=0
AIRSPACE_TRUSTED_PROXIES=10.0.0.0/8
AIRSPACE_TRUSTED_PROXY_HOPS=1
# Prefer *_FILE variants pointing at mounted secrets, e.g. AIRSPACE_PEPPER_FILE=/run/secrets/pepper
